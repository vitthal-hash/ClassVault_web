# MongoDB Atlas connection string. Stores user accounts plus all structured
# app data (semesters, subjects, notes, assignments, chat history, etc).
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=

# Optional - defaults to "classvault"
MONGODB_DB_NAME=

# Secret used to sign login session cookies. Set this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Cloudinary - stores the heavy files (lecture photos, syllabus/resource/
# assignment PDFs & docs) so they don't eat into the Mongo Atlas free tier.
# Free tier: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional deploy-time Gemini API key fallback. Users can also set their own
# key per-account in Settings, which always takes priority over this.
NEXT_PUBLIC_GEMINI_API_KEY=
